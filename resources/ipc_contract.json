      "optional": ["model_id", "device_preference", "dictionary_id", "resume_entry_id"]
    },
    "cancel_transcription": { "required": [], "optional": [] },
    "resume_transcription": { "required": ["entry_id"], "optional": [] },
    "get_models": { "required": [], "optional": [] },
    "get_models_directory": { "required": [], "optional": [] },
    "set_models_directory": { "required": ["path"], "optional": [] },
    "select_model": { "required": ["model_id"], "optional": [] },
    "download_model": { "required": ["model_id"], "optional": [] },
    "cancel_download": { "required": ["model_id"], "optional": [] },
    "remove_model": { "required": ["model_id"], "optional": [] },
    "get_dictionaries": { "required": [], "optional": [] },
    "select_dictionary": { "required": ["dictionary_id"], "optional": [] },
    "import_custom_dictionary": { "required": ["file_path"], "optional": [] },
    "remove_custom_dictionary": { "required": [], "optional": [] },
    "get_history": { "required": [], "optional": ["search_query"] },
    "get_history_entry": { "required": ["entry_id"], "optional": [] },
