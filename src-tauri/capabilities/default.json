{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for VoxNote desktop shell",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "shell:default",
    "updater:default",
    "process:allow-restart"
  ]
}
