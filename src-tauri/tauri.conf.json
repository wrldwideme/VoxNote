{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxNote",
  "version": "0.1.0",
  "identifier": "com.voxnote.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxNote — Локальная расшифровка аудио",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
